# The site's own absolute URL. Canonicals, hreflang, Open Graph and the
# sitemap are all built from it — a wrong value here is an SEO bug that looks
# fine locally.
NEXT_PUBLIC_SITE_URL=https://growencity.uz

# The API. Must be an origin the API's CORS_ORIGINS allows, or every
# authenticated request fails in the browser with no useful error.
NEXT_PUBLIC_API_URL=https://api.growencity.uz

# Extra hostnames next/image may load from, comma separated. The CDN zones
# the app uses are already allowed in next.config.ts; this is for a rename or
# a second zone without a code change.
# NEXT_PUBLIC_IMAGE_HOSTS=cdn2.example.net
